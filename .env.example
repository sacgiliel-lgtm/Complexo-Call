# Copie este arquivo para .env.local e preencha suas chaves

# --- LiveKit ---
LIVEKIT_API_KEY=sua_api_key_aqui
LIVEKIT_API_SECRET=seu_api_secret_aqui
NEXT_PUBLIC_LIVEKIT_URL=wss://seu-projeto.livekit.cloud

# --- Supabase ---
# URL e chave anônima: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
# Service Role Key: só usada no servidor (app/admin/create-user), NUNCA prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- Convidados (código de convite) ---
# Segredo usado para assinar o "passe" temporário de quem entra via convite.
# Gere um valor aleatório longo, ex: `openssl rand -hex 32`. NUNCA prefixar com NEXT_PUBLIC_
GUEST_TICKET_SECRET=gere_um_valor_aleatorio_longo_aqui

# --- Discord ---
# URL do Webhook do Discord para logs de quem entra/sai
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/sua-url-aqui
